#experimental git config homedir for coloration
[color]
    ui        = auto
[color "branch"]
    current   = yellow reverse
    local     = yellow
    remote    = green
[color "diff"]
    meta      = yellow bold
    frag      = magenta bold
    old       = red bold
    new       = green bold
[color "status"]
    added     = yellow
    changed   = green
    untracked = cyan
[core]
	autocrlf = false
	eol = lf
[user]
	email = skyleach@gmail.com
	name = Matt Gregory
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
# define command which will be used when "nvim" is set as a merge tool
[mergetool "neovide"]
    cmd = C:/Program Files/Neovide/neovide.exe -f -c \"Gvdiffsplit!\" \"$MERGED\"
  ; cmd = C:/ProgramData/chocolatey/bin/neovide.exe -f -c \"Gvdiffsplit!\" \"$MERGED\"
# set "nvim" as tool for merging
[merge]
    tool = C:/Program Files/Neovide/neovide.exe -f -c \"Gvdiffsplit!\" \"$MERGED\"
  ; tool = C:/ProgramData/chocolatey/bin/neovide.exe
# automatically launch merge tool without displaying a prompt
[mergetool]
  prompt = false
